# ---------------------------------------------------------------------------
# ubuntu-lite build configuration
# Every value here can be overridden in config/build.local.env (git-ignored)
# or via environment variables when running build/build.sh.
# ---------------------------------------------------------------------------

# Image identity
IMAGE_NAME=ubuntu-lite
UBUNTU_SUITE=noble
ARCH=amd64
# Build-time only. The installed system never talks to this mirror.
UBUNTU_MIRROR=http://archive.ubuntu.com/ubuntu

# Kernel: "virtual-hwe-24.04" = newest HWE kernel (best for recent bare metal),
# "virtual" = 6.8 GA kernel. Both are the generic kernel binary; we add
# linux-modules-extra ourselves so all bare-metal drivers are present.
KERNEL_FLAVOUR=virtual-hwe-24.04

# Firmware: select = only the packages in config/packages/firmware.txt (~110 MB)
#           full   = the whole linux-firmware set (~650 MB)
#           none   = no firmware at all (VMs only)
FIRMWARE_MODE=select

# Primary user (sudo + docker group). Password is forced to change at first login.
USERNAME=dev
USER_PASSWORD=changeme
# 1 = log the user in automatically on tty1 and start sway. 0 = normal login prompt.
AUTOLOGIN=0
TIMEZONE=Asia/Jakarta
LOCALE=en_US.UTF-8
KEYMAP=us
# Swap file created by the installer on the root filesystem ("0" disables)
SWAP_SIZE=2G
# Extra kernel parameters for the installed system. The serial console makes
# QEMU tests and headless debugging possible; harmless on machines without a UART.
SERIAL_CONSOLE_CMDLINE="console=ttyS0,115200n8 console=tty1"

# Nexus Repository OSS in the office. The installed system uses ONLY these
# sources for apt / docker. See docs/nexus-setup.md.
NEXUS_URL=https://nexus.office.local
# Optional: if the air-gapped network has no DNS for the Nexus hostname,
# set its IP here and an /etc/hosts entry is baked into the image.
NEXUS_IP=
NEXUS_APT_REPO=apt-lite
NEXUS_RAW_REPO=raw-lite
# host:port of the docker (hosted) repository's HTTPS connector
NEXUS_DOCKER_REGISTRY=nexus.office.local:8443
# 1 = registry is plain HTTP (adds insecure-registries to daemon.json)
NEXUS_DOCKER_INSECURE=0

# Office integration (all optional, leave empty to skip).
# Kerberos realm = AD domain in UPPER CASE, e.g. CORP.EXAMPLE.COM
AD_REALM=
# DNS domain in lower case, e.g. corp.example.com (Chrome SSO allow-list uses *.domain)
AD_DOMAIN=
# Domain controllers / KDCs, space separated hostnames or IPs. Required when the
# network has no DNS SRV records for the realm.
AD_KDC=
# Outlook Web App URL, opened with Super+m, e.g. https://mail.corp.example.com/owa
OWA_URL=
# Extra /etc/hosts entries for networks without DNS: "ip name [alias]" entries separated by '|'
# e.g. EXTRA_HOSTS="10.1.1.5 dc1.corp.example.com dc1|10.1.1.20 mail.corp.example.com"
EXTRA_HOSTS=

# What to bundle on the ISO for day one (also uploaded to Nexus later)
BUNDLE_DOCKER_IMAGES=1
# only used when "code" is in config/packages/gui.txt
BUNDLE_VSCODE_EXTENSIONS=0
BUNDLE_GITHUB_BINARIES=1
