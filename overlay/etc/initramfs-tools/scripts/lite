# initramfs-tools boot script, selected with kernel parameter boot=lite
# Finds the ISO/USB labelled UBUNTU_LITE, mounts /lite/filesystem.squashfs and
# stacks a tmpfs overlay on top so the live system is writable.
# Exposed to the running system as:
#   /run/lite/iso  - the ISO (read-only)
#   /run/lite/ro   - the squashfs (read-only, used by the installer as source)

mount_top()      { :; }
mount_premount() { :; }
mount_bottom()   { :; }

mountroot() {
	[ "$quiet" != "y" ] && log_begin_msg "Starting ubuntu-lite live boot"
	modprobe loop 2>/dev/null || true
	modprobe squashfs 2>/dev/null || true
	modprobe overlay 2>/dev/null || true
	modprobe isofs 2>/dev/null || true
	modprobe vfat 2>/dev/null || true

	LABEL="UBUNTU_LITE"
	for x in $(cat /proc/cmdline); do
		case "$x" in
			lite.label=*) LABEL="${x#lite.label=}" ;;
		esac
	done

	# say what we are doing on the screen and on the serial console, if any
	say() { echo "lite: $*"; [ -c /dev/ttyS0 ] && grep -q 'console=ttyS0' /proc/cmdline && echo "lite: $*" > /dev/ttyS0 2>/dev/null; return 0; }

	# Hybrid ISOs expose the label on the whole disk and on one of its partitions;
	# try whole disks first, then partitions, as iso9660 or vfat (ISO contents
	# copied onto a FAT stick with the same label also work).
	mkdir -p /run/lite/iso
	found=""
	i=0
	while [ $i -lt 60 ] && [ -z "$found" ]; do
		udevadm settle --timeout=2 2>/dev/null || true
		for dev in $(blkid -o device -t LABEL="$LABEL" 2>/dev/null | awk '{ print length($0), $0 }' | sort -n | cut -d' ' -f2-); do
			for fstype in iso9660 vfat; do
				if mount -t $fstype -o ro "$dev" /run/lite/iso 2>/dev/null; then
					if [ -f /run/lite/iso/lite/filesystem.squashfs ]; then found="$dev"; break 2; fi
					umount /run/lite/iso 2>/dev/null || true
				fi
			done
		done
		[ -n "$found" ] && break
		[ $i -eq 0 ] && say "waiting for a device labelled $LABEL ..."
		sleep 1
		i=$((i + 1))
	done
	[ -n "$found" ] || panic "lite: could not find the $LABEL medium"
	say "using $found"

	mkdir -p /run/lite/ro /run/lite/rw
	loopdev=$(losetup -f) || panic "lite: no free loop device"
	losetup -r "$loopdev" /run/lite/iso/lite/filesystem.squashfs || panic "lite: losetup failed"
	mount -t squashfs -o ro "$loopdev" /run/lite/ro || panic "lite: cannot mount squashfs"
	mount -t tmpfs -o mode=0755 tmpfs /run/lite/rw
	mkdir -p /run/lite/rw/upper /run/lite/rw/work
	mount -t overlay overlay \
		-o lowerdir=/run/lite/ro,upperdir=/run/lite/rw/upper,workdir=/run/lite/rw/work \
		"${rootmnt}" || panic "lite: cannot mount overlay"

	# /run is moved into the real root by init, so /run/lite/* stay reachable.
	[ "$quiet" != "y" ] && log_end_msg
}
