[Unit]
Description=ubuntu-lite unattended installer (runs only when booted with lite.install)
ConditionKernelCommandLine=lite.install
After=basic.target systemd-udev-settle.service
Wants=systemd-udev-settle.service
Conflicts=getty@tty1.service

[Service]
Type=oneshot
ExecStart=/usr/lib/ubuntu-lite/install.sh
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
