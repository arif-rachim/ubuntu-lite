#!/bin/bash
# Get a Kerberos ticket for the office AD realm: lite-login [username]
. /usr/share/ubuntu-lite/lite.conf
[ -f /etc/ubuntu-lite/site.conf ] && . /etc/ubuntu-lite/site.conf
[ -n "${AD_REALM:-}" ] || { echo "AD_REALM is not configured in this image (config/build.env)"; exit 1; }
user=${1:-$USER}
exec kinit "${user%%@*}@$AD_REALM"
