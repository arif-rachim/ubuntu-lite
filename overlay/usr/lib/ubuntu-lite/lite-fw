#!/bin/bash
# lite-fw: watch, block and allowlist inbound traffic (nftables, no daemon).
#
#   lite-fw status                 mode, open ports, blocked/allowed/auto-banned hosts, recent hits
#   lite-fw watch                  live view of dropped connection attempts (source, port, proto)
#   lite-fw top [since]            attempts per source IP, e.g. `lite-fw top -24h` (default -1h)
#   lite-fw ports                  listening ports on this machine (ss -tulpn)
#   lite-fw block  IP|CIDR         add to the blocklist (persistent)          lite-fw unblock IP|CIDR
#   lite-fw allow  IP|CIDR         add to the allowlist (persistent, never auto-banned)   lite-fw unallow IP|CIDR
#   lite-fw mode   open|allowlist  open: anyone may reach the open ports; allowlist: only allowed IPs
#   lite-fw open   PORT[/udp]      open a port (tcp default)                   lite-fw close PORT[/udp]
#   lite-fw ban-time 1h|30m|2d     how long auto-banned scanners stay blocked
#   lite-fw banned                 currently auto-banned hosts                 lite-fw unban IP
#   lite-fw list                   show the persistent lists
#   lite-fw apply                  re-render /etc/nftables.d and reload
set -euo pipefail
CONF=/etc/ubuntu-lite/fw.conf
ALLOW=/etc/ubuntu-lite/fw-allow.txt
BLOCK=/etc/ubuntu-lite/fw-block.txt
MODE=open; TCP_PORTS="22"; UDP_PORTS=""; BAN_TIME=1h
# shellcheck disable=SC1090
[ -f "$CONF" ] && . "$CONF"
die() { echo "lite-fw: $*" >&2; exit 1; }
root() { [ "$(id -u)" = 0 ] || die "this command needs sudo"; }
valid_ip() { [[ "$1" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}(/[0-9]{1,2})?$ ]] || die "not an IPv4 address or CIDR: $1"; }
lst() { [ -f "$1" ] && grep -vE '^\s*(#|$)' "$1" || true; }
elements() { local e; e=$(lst "$1" | paste -sd, -); [ -n "$e" ] && echo "elements = { $e }"; }

save_conf() {
	cat > "$CONF" <<-C
	# lite-fw settings (edit with \`sudo lite-fw ...\`)
	MODE=$MODE
	TCP_PORTS="$TCP_PORTS"
	UDP_PORTS="$UDP_PORTS"
	BAN_TIME=$BAN_TIME
	C
}

render() {
	mkdir -p /etc/nftables.d
	{
		echo "# rendered by lite-fw $(date -u +%FT%TZ)"
		echo "table inet lite {"
		echo "	set allow4 { type ipv4_addr; flags interval; $(elements "$ALLOW") }"
		echo "	set block4 { type ipv4_addr; flags interval; $(elements "$BLOCK") }"
		echo "	set scanners { type ipv4_addr; flags dynamic,timeout; timeout $BAN_TIME; size 65535; }"
		echo "}"
	} > /etc/nftables.d/10-lists.nft
	local src="" fsrc=""
	if [ "$MODE" = allowlist ]; then src="ip saddr @allow4 "; fi
	{
		echo "# rendered by lite-fw (mode $MODE, tcp ${TCP_PORTS:-none}, udp ${UDP_PORTS:-none})"
		echo "table inet lite {"
		echo "	chain services {"
		[ -n "$TCP_PORTS" ] && echo "		${src}tcp dport { $(echo "$TCP_PORTS" | tr ' ' ',') } accept"
		[ -n "$UDP_PORTS" ] && echo "		${src}udp dport { $(echo "$UDP_PORTS" | tr ' ' ',') } accept"
		echo "	}"
		echo "	chain forward_services {"
		[ "$MODE" = allowlist ] && echo "		ct state new ip saddr != @allow4 counter drop"
		echo "	}"
		echo "}"
	} > /etc/nftables.d/20-services.nft
}

apply() {
	root; render; save_conf
	nft -c -f /etc/nftables.conf || die "generated ruleset is invalid (see above), nothing changed"
	nft -f /etc/nftables.conf
	echo "lite-fw: applied (mode $MODE, tcp ${TCP_PORTS:-none}${UDP_PORTS:+, udp $UDP_PORTS}, ban $BAN_TIME)"
}

add_to()   { root; valid_ip "$2"; touch "$1"; grep -qxF "$2" "$1" || echo "$2" >> "$1"; }
del_from() { root; valid_ip "$2"; [ -f "$1" ] && sed -i "\#^$2\$#d" "$1"; }

parse_log() { # stdin: kernel log lines -> "time src dst proto dport"
	sed -nE 's/^([^ ]+) [^ ]+ kernel: (\[[^]]*\] )?lite-fw drop: .*SRC=([0-9a-f.:]+) DST=([0-9a-f.:]+) .*PROTO=([A-Z0-9]+)( SPT=[0-9]+ DPT=([0-9]+))?.*/\1|\3|\4|\5|\7/p' \
	| awk -F'|' '{printf "%-25s %-18s -> %-15s %-5s %s\n", substr($1,1,25), $2, $3, $4, $5}'
}

case "${1:-status}" in
	status)
		echo "mode: $MODE   tcp: ${TCP_PORTS:-none}   udp: ${UDP_PORTS:-none}   auto-ban: $BAN_TIME"
		echo "allowlist ($(lst "$ALLOW" | wc -l)): $(lst "$ALLOW" | paste -sd' ' -)"
		echo "blocklist ($(lst "$BLOCK" | wc -l)): $(lst "$BLOCK" | paste -sd' ' -)"
		if [ "$(id -u)" = 0 ]; then
			echo "auto-banned now: $(nft -j list set inet lite scanners 2>/dev/null | jq -r '[.nftables[].set.elem[]? | (.elem.val // .) | tostring] | join(" ")' 2>/dev/null)"
			echo; echo "last dropped attempts:"; journalctl -k --no-pager -o short-iso --since -1h 2>/dev/null | grep "lite-fw drop" | tail -n 8 | parse_log
		else
			echo "(run with sudo to see auto-banned hosts and recent hits)"
		fi ;;
	watch)  root; echo "watching dropped inbound attempts (ctrl-c to stop)"; journalctl -kf -n 0 -o short-iso 2>/dev/null | grep --line-buffered "lite-fw drop" | parse_log ;;
	top)    root; journalctl -k --no-pager -o short-iso --since "${2:--1h}" 2>/dev/null | grep "lite-fw drop" | parse_log \
	        | awk '{n[$2]++; p[$2]=p[$2] (index(p[$2],$5)?"":" "$5); t[$2]=$1} END{for(i in n) printf "%6d  %-18s last %s  ports:%s\n", n[i], i, t[i], p[i]}' | sort -rn | head -n 30 ;;
	ports)  ss -tulpnH 2>/dev/null | awk '{printf "%-5s %-25s %s\n", $1, $5, $7}' | sort -u ;;
	block)   add_to "$BLOCK" "${2:?ip}"; apply ;;
	unblock) del_from "$BLOCK" "${2:?ip}"; apply ;;
	allow)   add_to "$ALLOW" "${2:?ip}"; apply ;;
	unallow) del_from "$ALLOW" "${2:?ip}"; apply ;;
	mode)
		root; case "${2:-}" in
			open) MODE=open ;;
			allowlist)
				[ -n "$(lst "$ALLOW")" ] || die "allowlist is empty; add your own IP first: lite-fw allow <ip>"
				if [ -n "${SSH_CLIENT:-}" ]; then
					me=${SSH_CLIENT%% *}
					python3 - "$me" $(lst "$ALLOW") <<-'PY' || die "your ssh client $me is not in the allowlist; add it first (or run from the console)"
					import ipaddress,sys
					me=ipaddress.ip_address(sys.argv[1]); sys.exit(0 if any(me in ipaddress.ip_network(n,strict=False) for n in sys.argv[2:]) else 1)
					PY
				fi
				MODE=allowlist ;;
			*) die "usage: lite-fw mode open|allowlist" ;;
		esac; apply ;;
	open|close)
		root; spec=${2:?port}; proto=tcp; case "$spec" in */udp) proto=udp; spec=${spec%/udp} ;; */tcp) spec=${spec%/tcp} ;; esac
		[[ "$spec" =~ ^[0-9]+$ ]] || die "port must be a number"
		var=TCP_PORTS; [ $proto = udp ] && var=UDP_PORTS
		cur=" ${!var} "
		if [ "$1" = open ]; then [[ "$cur" == *" $spec "* ]] || declare "$var=$(echo "${!var} $spec" | xargs)"; else declare "$var=$(echo "$cur" | sed "s/ $spec / /" | xargs)"; fi
		apply ;;
	ban-time) root; [[ "${2:-}" =~ ^[0-9]+[smhd]$ ]] || die "e.g. 30m, 1h, 2d"; BAN_TIME=$2; apply ;;
	banned)   root; nft list set inet lite scanners ;;
	unban)    root; valid_ip "${2:?ip}"; nft delete element inet lite scanners "{ $2 }" && echo "unbanned $2" ;;
	list)     echo "allowlist:"; lst "$ALLOW" | sed 's/^/  /'; echo "blocklist:"; lst "$BLOCK" | sed 's/^/  /' ;;
	apply)    apply ;;
	-h|--help|help) sed -n '2,17p' "$0" ;;
	*) die "unknown command $1 (see lite-fw help)" ;;
esac
